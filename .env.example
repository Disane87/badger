# Public base URL used when generating tracking links.
# Set this to your deployed domain so the copied URLs point at the right host
# (instead of the browser's current origin / localhost).
NUXT_PUBLIC_BASE_URL=https://honey.example.com

# Outbound IP -> geo enrichment via ip-api.com (true/false).
# Set to false to keep everything local with no outbound requests.
NUXT_GEO_LOOKUP=true
